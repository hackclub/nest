{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["../backend/src/*"],
			"@email/*": ["../backend/emails/*"]
		}
	}
}
